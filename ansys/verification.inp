/BATCH
/CLEAR,NOSTART
/FILNAME,beamcheck
/PREP7
ET,1,188
KEYOPT,1,3,3
MP,EX,1,69000
MP,PRXY,1,0.3
SECTYPE,1,BEAM,RECT
SECDATA,25,30
*DO,j,0,4
N,j+1,j*500/4,0,0
*ENDDO
*DO,j,1,4
E,j,j+1
*ENDDO
D,1,ALL,0
F,5,FY,-100
FINISH
/SOLU
ANTYPE,STATIC
NLGEOM,OFF
OUTRES,ALL,ALL
SOLVE
FINISH
/POST1
SET,LAST
*GET,tip,NODE,5,U,Y
*GET,reaction,NODE,1,RF,FY
ETABLE,rootmz,SMISC,3
*GET,moment,ELEM,1,ETAB,rootmz
stress=ABS(moment)*6/(30*25**2)
*CFOPEN,case0_4,csv
*VWRITE,tip,reaction,stress
(E24.16,',',E24.16,',',E24.16)
*CFCLOS
FINISH

